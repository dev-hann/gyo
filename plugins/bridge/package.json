{
  "name": "@gyo-framework/bridge",
  "version": "0.1.3",
  "description": "Core bridge library for Gyo framework - enables web-native communication",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "android/src",
    "android/build.gradle.kts",
    "ios/Sources",
    "ios/Package.swift",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck",
    "clean": "rm -rf dist android/build ios/.build"
  },
  "keywords": [
    "gyo",
    "bridge",
    "webview",
    "android",
    "ios",
    "native",
    "cross-platform",
    "web-native"
  ],
  "author": "Gyo Framework",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-hann/gyo.git",
    "directory": "plugins/bridge"
  },
  "bugs": {
    "url": "https://github.com/dev-hann/gyo/issues"
  },
  "homepage": "https://github.com/dev-hann/gyo#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.0.0"
  }
}
