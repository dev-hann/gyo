{
  "name": "@gyo-framework/test-utils",
  "version": "0.1.0",
  "description": "Test utilities for Gyo framework apps — bridge mocking, platform simulation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "gyo",
    "test",
    "testing",
    "mock",
    "bridge",
    "webview"
  ],
  "author": "Gyo Framework",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-hann/gyo.git",
    "directory": "plugins/test-utils"
  },
  "bugs": {
    "url": "https://github.com/dev-hann/gyo/issues"
  },
  "homepage": "https://github.com/dev-hann/gyo#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@gyo-framework/bridge": "^0.1.3"
  },
  "devDependencies": {
    "@gyo-framework/bridge": "^0.1.3",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.0",
    "tsup": "^8.0.0"
  }
}
