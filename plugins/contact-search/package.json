{
  "name": "@gyo-framework/contact-search",
  "version": "0.1.0",
  "description": "Gyo plugin for searching contacts via Android ContactsProvider",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "android/src",
    "android/build.gradle.kts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck",
    "clean": "rm -rf dist android/build"
  },
  "keywords": [
    "gyo",
    "contact-search",
    "contacts",
    "android",
    "bridge",
    "plugin"
  ],
  "author": "Gyo Framework",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-hann/gyo.git",
    "directory": "plugins/contact-search"
  },
  "bugs": {
    "url": "https://github.com/dev-hann/gyo/issues"
  },
  "homepage": "https://github.com/dev-hann/gyo#readme",
  "publishConfig": {
    "access": "public"
  },
  "gyo": {
    "bridgeName": "contact_search",
    "android": {
      "handlerClass": "gyo.plugins.contact_search.ContactSearchBridge"
    }
  },
  "peerDependencies": {
    "@gyo-framework/bridge": "^0.1.3"
  },
  "devDependencies": {
    "@gyo-framework/bridge": "^0.1.3",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.0.0"
  }
}
