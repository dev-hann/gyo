<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility (Android 11+): the apps with a launcher icon. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Hands an APK kept in cache/apk_install to the package installer.
         The authority follows the app: the manifest merger fills in its application id. -->
    <application>
        <provider
            android:name="gyo.plugins.app_launcher.ApkFileProvider"
            android:authorities="${applicationId}.gyo.app_launcher"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/gyo_app_launcher_paths" />
        </provider>
    </application>

</manifest>
