{
  "name": "gyo",
  "version": "1.0.0",
  "description": "[![NPM version](https://img.shields.io/npm/v/gyo.svg?style=flat)](https://www.npmjs.com/package/gyo) [![Build Status](https://img.shields.io/travis/com/gyo-framework/gyo/main.svg?style=flat)](https://travis-ci.com/gyo-framework/gyo) [![License: MIT](https://img.shields.io/badge/License-MIT-yellow.svg)](https://opensource.org/licenses/MIT)",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "test": "npm run test:plugins",
    "test:plugins": "cd plugins/camera && npm test && cd ../geolocation && npm test",
    "test:camera": "cd plugins/camera && npm test",
    "test:geolocation": "cd plugins/geolocation && npm test",
    "build": "npm run build:bridge && npm run build:plugins",
    "build:bridge": "cd plugins/bridge && npm run build",
    "build:plugins": "cd plugins/camera && npm run build && cd ../geolocation && npm run build",
    "lint": "cd cli && npm run lint",
    "lint:fix": "cd cli && npm run lint:fix",
    "format": "cd cli && npm run format",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-hann/gyo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dev-hann/gyo/issues"
  },
  "homepage": "https://github.com/dev-hann/gyo#readme",
  "devDependencies": {
    "@types/node": "^25.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "typescript": "^5.9.3"
  }
}
