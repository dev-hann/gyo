{
  "name": "{{PROJECT_NAME}}",
  "version": "1.0.0",
  "profiles": {
    "development": {
      "serverUrl": "http://localhost:3000"
    },
    "production": {
      "serverUrl": "https://your-production-url.com"
    }
  },
  "platforms": {
    "android": {
      "enabled": true,
      "packageName": "com.example.{{PROJECT_NAME_LOWER}}"
    },
    "ios": {
      "enabled": true,
      "bundleId": "com.example.{{PROJECT_NAME_LOWER}}"
    }
  },
  "webview": {
    "allowFileAccess": false,
    "allowUniversalAccessFromFileURLs": false,
    "userAgent": "gyo-webview/1.0"
  },
  "script": {
    "start": "YOUR_WEB_SERVER_START_COMMAND (e.g., npm run dev, yarn dev, pnpm dev)"
  }
}
