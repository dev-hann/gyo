{
  "name": "@gyo-framework/cli",
  "version": "0.1.0",
  "description": "CLI tool for Gyo framework - Build cross-platform apps with web technologies",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gyo": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.js",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config e2e/jest.config.cjs --runInBand --verbose"
  },
  "keywords": [
    "gyo",
    "webview",
    "cross-platform",
    "mobile",
    "desktop",
    "cli",
    "framework"
  ],
  "author": "Gyo Framework",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-hann/gyo.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/dev-hann/gyo/issues"
  },
  "homepage": "https://github.com/dev-hann/gyo#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@types/inquirer": "^9.0.9",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^13.1.0",
    "open": "^9.1.0",
    "ora": "^5.4.1"
  }
}
