{
  "name": "@gyo-framework/cli",
  "version": "0.2.0",
  "description": "CLI tool for Gyo framework - Build cross-platform apps with web technologies",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gyo": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.js",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../node_modules/jest/bin/jest.js --watch",
    "test:e2e": "npm run test:e2e:local && npm run test:e2e:device",
    "test:e2e:local": "jest --config e2e/jest.config.cjs --runInBand --verbose --testPathPatterns='local-pipeline'",
    "test:e2e:device": "jest --config e2e/jest.config.cjs --runInBand --verbose --testPathPatterns='device-pipeline|device-media'",
    "test:e2e:android": "jest --config e2e/jest.config.cjs --runInBand --verbose --testPathPatterns='android-compile'",
    "test:all": "npm run test && npm run test:e2e:local"
  },
  "keywords": [
    "gyo",
    "webview",
    "cross-platform",
    "mobile",
    "desktop",
    "cli",
    "framework"
  ],
  "author": "Gyo Framework",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-hann/gyo.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/dev-hann/gyo/issues"
  },
  "homepage": "https://github.com/dev-hann/gyo#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.11",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "tsup": "^9.0.0"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "fs-extra": "^11.4.1",
    "inquirer": "^14.3.1",
    "open": "^11.0.4",
    "ora": "^10.0.0"
  }
}
